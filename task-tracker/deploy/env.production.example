# Copy to /opt/task-tracker/.env and edit. (Keep this file OUT of git — it holds secrets.)

DB_BACKEND=sqlite
SQLITE_PATH=/opt/task-tracker/dev.db
UPLOAD_ROOT=/opt/task-tracker/uploads

# Generate a long random value once and never change it (changing it logs everyone out):
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-LONG-RANDOM-STRING

# Served over HTTPS via the Cloudflare tunnel -> secure session cookie
SESSION_COOKIE_SECURE=1
